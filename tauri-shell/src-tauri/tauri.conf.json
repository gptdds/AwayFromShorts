{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AwayFromShorts",
  "version": "2.0.0",
  "identifier": "com.awayfromshorts.desktop",
  "build": {
    "frontendDist": null
  },
  "app": {
    "windows": [
      {
        "title": "AwayFromShorts · 配置面板",
        "url": "http://127.0.0.1:8737",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "AwayFromShorts"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "远离短视频成瘾",
    "longDescription": "按周计划自动屏蔽短视频网站和程序，提供可视化桌面面板配置一切。",
    "resources": {
      "bundle-resources": ""
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": ["SimpChinese"]
      }
    }
  }
}
