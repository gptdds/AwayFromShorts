{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AwayFromShorts cross-platform contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "contractVersion",
    "minimumReaderVersion",
    "unknownFieldPolicy",
    "unknownFeaturePolicy",
    "scopeMask",
    "features",
    "platformBindings",
    "sync"
  ],
  "properties": {
    "id": {
      "const": "awayfromshorts.cross-platform"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "minimumReaderVersion": {
      "type": "integer",
      "minimum": 1
    },
    "unknownFieldPolicy": {
      "enum": [
        "reject",
        "preserve"
      ]
    },
    "unknownFeaturePolicy": {
      "enum": [
        "reject",
        "warn"
      ]
    },
    "scopeMask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schedule",
        "quota",
        "orSet",
        "study",
        "penalty",
        "all"
      ],
      "properties": {
        "schedule": {
          "const": 1
        },
        "quota": {
          "const": 2
        },
        "orSet": {
          "const": 4
        },
        "study": {
          "const": 8
        },
        "penalty": {
          "const": 16
        },
        "all": {
          "const": 31
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "version",
          "support",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pc",
              "phone"
            ],
            "properties": {
              "pc": {
                "type": "boolean"
              },
              "phone": {
                "type": "boolean"
              }
            }
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "platformBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pc",
        "phone"
      ],
      "properties": {
        "pc": {
          "type": "object"
        },
        "phone": {
          "type": "object"
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "hub",
        "deviceSections",
        "capabilityField",
        "conflictPolicy",
        "unknownFields",
        "unsupportedFeature"
      ],
      "properties": {
        "hub": {
          "const": "hub-config.json"
        },
        "deviceSections": {
          "type": "array",
          "contains": {
            "const": "pc"
          },
          "items": {
            "enum": [
              "pc",
              "phone"
            ]
          }
        },
        "capabilityField": {
          "const": "contract"
        },
        "conflictPolicy": {
          "type": "string"
        },
        "unknownFields": {
          "const": "preserve"
        },
        "unsupportedFeature": {
          "const": "warn-and-skip"
        }
      }
    }
  }
}
